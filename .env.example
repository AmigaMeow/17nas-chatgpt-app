APP_PORT=8790
APP_BIND=127.0.0.1
APP_PUBLIC_ORIGIN=http://127.0.0.1:8791
APP_IPV6_PROBE_URL=
APP_STATS_FILE=/var/lib/17nas-chatgpt-app/stats/snapshot.json
