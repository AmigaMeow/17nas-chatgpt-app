# Enable only after certificate issuance. In the stream SNI map, add:
# mcp.17nas.com 127.0.0.1:4446;
# The IPv6-only probe has its own destination-address route; do not change it.
server {
    listen 80;
    server_name mcp.17nas.com;
    access_log off;
    error_log /dev/null;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/17nas-app-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://mcp.17nas.com$request_uri; }
}
server {
    listen 127.0.0.1:4446 ssl proxy_protocol;
    server_name mcp.17nas.com;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    ssl_certificate /etc/letsencrypt/live/mcp.17nas.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.17nas.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null;
    client_max_body_size 16k;
    if ($host != mcp.17nas.com) { return 404; }
    location = /.well-known/openai-apps-challenge {
        default_type text/plain;
        return 200 'mU1t8DneY9m-bDWgAt2RgxRD20lqQKvBgMmF2NLeqkk';
    }
    location / { include /etc/nginx/snippets/17nas-app-proxy.inc; }
}
