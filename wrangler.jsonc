{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "17nas-chatgpt-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "app.17nas.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "COUNTERS", "class_name": "CountryCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CountryCounter"] }],
  "kv_namespaces": [
    { "binding": "STATS", "id": "REPLACE_WITH_APP_STATS_NAMESPACE" },
    { "binding": "ABUSE", "id": "REPLACE_WITH_APP_SHORT_LIVED_NAMESPACE" }
  ],
  "vars": { "PUBLIC_ORIGIN": "https://app.17nas.com", "IPV6_PROBE_URL": "", "RELEASE": "0.1.0" }
}
